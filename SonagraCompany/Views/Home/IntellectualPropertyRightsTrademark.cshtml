<section class="service-detail-hero trademark-hero">
    <div class="container site-container">
        <span class="eyebrow">Brand Protection &amp; Intellectual Property</span>
        <h1>Intellectual Property Rights –<br />Trademark (TM)</h1>
        <p>Practical trademark support to help businesses protect, register and manage the brand assets that distinguish their products and services.</p>
    </div>
</section>

<section class="service-detail-section section-space">
    <div class="container site-container">
        <div class="row gy-5">
            <div class="col-lg-8">
                <span class="eyebrow eyebrow-dark">Intellectual Property Rights – Trademark (TM)</span>
                <h2 class="section-title">Our Services</h2>
                <p class="lead-copy">A strong trademark is an important business asset. Sonagra &amp; Company assists businesses, promoters and brand owners with trademark searches, applications, prosecution and related ownership documentation.</p>
                <p>Our support is designed to help clients make informed decisions before adopting a mark and to manage the registration and protection process with clear documentation and timely follow-up.</p>

                <div class="service-detail-points">
                    <h3>Intellectual Property Rights - Trademark (TM)</h3>
                    <div class="service-detail-list">
                        <article><span>01</span><div><h3>Conducting Expansive Trademark Searches</h3><p>Conducting Expansive Trademark searches.</p></div></article>
                        <article><span>02</span><div><h3>Drafting &amp; Filing Trademark Applications</h3><p>Drafting &amp; filing Trademark Applications.</p></div></article>
                        <article><span>03</span><div><h3>Follow-ups and Prosecution of Trademark Application</h3><p>Follow-ups and Prosecution of Trademark Application.</p></div></article>
                        <article><span>04</span><div><h3>Appearing Before the Official Registry for Trademarks</h3><p>Appearing before the official registry for Trademarks.</p></div></article>
                        <article><span>05</span><div><h3>Drafting and Filing Assignment Deeds for Trademark</h3><p>Drafting and filing Assignment Deeds for Trademark.</p></div></article>
                        <article><span>06</span><div><h3>Transfer of Ownership of Trademark</h3><p>Transfer of ownership of Trademark.</p></div></article>
                    </div>
                </div>
            </div>

            <aside class="col-lg-4">
                <div class="service-detail-sidebar">
                    <h2>Our Services</h2>
                    @foreach (var service in relatedServices)
                    {
                        if (service.Item1 == "Intellectual Property Rights - Trademark (TM)")
                        {
                            <a class="active" href="@service.Item2">@service.Item1</a>
                        }
                        else
                        {
                            <a href="@service.Item2">@service.Item1 <span>↗</span></a>
                        }
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="reference-cta section-space-sm">
    <div class="container site-container">
        <div class="reference-cta-inner">
            <div>
                <span class="eyebrow">Protect the value of your brand.</span>
                <h2>Build a stronger trademark strategy with clear guidance.</h2>
                <p>Speak with Sonagra &amp; Company for trademark registration, prosecution and ownership support.</p>
            </div>
            <a class="btn btn-gold" href="/Home/Contact">Discuss your trademark matter <span>↗</span></a>
        </div>
    </div>
</section>
