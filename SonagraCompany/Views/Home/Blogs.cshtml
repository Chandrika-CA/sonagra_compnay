@model IReadOnlyList<BlogPost>
@{
    ViewData["Title"] = "Blogs | Sonagra & Company";
    ViewData["Description"] = "Articles and updates from Sonagra & Company on corporate governance, company law, SEBI, FEMA and compliance.";
}

<section class="service-detail-hero uniform-hero">
    <div class="container site-container">
        <span class="eyebrow">Insights &amp; updates</span>
        <h1>Blogs</h1>
        <p>Practical articles on company registration, ROC compliance, SEBI, FEMA and corporate governance from our company secretaries.</p>
    </div>
</section>

@if (Model.Count == 0)
{
    <section class="section-space blogs-empty-section">
        <div class="container site-container">
            <div class="text-center scroll-reveal reveal-up"><h2 class="blogs-empty-title">No Blogs</h2></div>
        </div>
    </section>
}
else
{
    @for (var i = 0; i < Model.Count; i++)
    {
        var post = Model[i];
        var imageLeft = i % 2 == 1;
        var sectionClass = "reference-intro blog-row section-space" + (imageLeft ? " section-paper" : "");
        <section class="@sectionClass">
            <div class="container site-container">
                <div class="row align-items-center gy-5 gx-lg-5">
                    @if (imageLeft)
                    {
                        <div class="col-lg-6 scroll-reveal reveal-left"><a href="/blogs/@post.Slug" tabindex="-1" aria-hidden="true"><div class="reference-image-frame"><img src="~/images/@Uri.EscapeDataString(post.ImageFile)" alt="@post.Title" loading="lazy" /></div></a></div>
                    }
                    <div class="col-lg-6 scroll-reveal @(imageLeft ? "reveal-right" : "reveal-left")">
                        <span class="eyebrow eyebrow-dark">@post.Category</span>
                        <h2 class="section-title"><a href="/blogs/@post.Slug">@post.Title</a></h2>
                        <p>@post.Description</p>
                        <div class="blog-card-meta"><time datetime="@post.Published.ToString("yyyy-MM-dd")">@post.Published.ToString("dd MMM yyyy")</time><span>·</span><span>@post.ReadMinutes min read</span></div>
                        <a class="text-link" href="/blogs/@post.Slug">Read article <span>↗</span></a>
                    </div>
                    @if (!imageLeft)
                    {
                        <div class="col-lg-6 scroll-reveal reveal-right"><a href="/blogs/@post.Slug" tabindex="-1" aria-hidden="true"><div class="reference-image-frame"><img src="~/images/@Uri.EscapeDataString(post.ImageFile)" alt="@post.Title" loading="lazy" /></div></a></div>
                    }
                </div>
            </div>
        </section>
    }
}
