@{
    ViewData["Title"] = "Amalgamation, Merger, De-merger & Takeover | Sonagra & Company";
    ViewData["Description"] = "Support for amalgamation, merger, de-merger, takeover and corporate restructuring transactions.";

    var relatedServices = new[]
    {
        ("Formation of Business Entities", "/our-services/formation-of-business-entities/"),
        ("Company Law & LLP Compliances", "/our-services/company-law-llp-compliances/"),
        ("SEBI Matters and IPO Services", "/our-services/sebi-matters-and-ipo-services/"),
        ("FEMA Matters", "/our-services/fema-matters/"),
        ("Intellectual Property Rights - Trademark (TM)", "/our-services/intellectual-property-rights-trademark-tm/"),
        ("Amalgamation, Merger, De-merger & Takeover", "/our-services/amalgamation-merger-de-merger-takeover/"),
        ("RBI and NBFC Related Compliances", "/our-services/rbi-and-nbfc-related-compliances/"),
        ("Transactional Due Diligence Services", "/our-services/transactional-due-diligence-services/"),
        ("Corporate Governance Services", "/our-services/corporate-governance-services/"),
        ("Corporate Law and Advisory", "/our-services/corporate-law-and-advisory/"),
        ("Liquidation Under Insolvency and Bankruptcy Code 2016", "/our-services/liquidation-under-insolvency-and-bankruptcy-code-2016/"),
        ("NCLT Services", "/our-services/nclt-services/"),
        ("Legal Metrology Act, 2009", "/our-services/legal-metrology-act-2009/"),
        ("XBRL Filing", "/our-services/xbrl-filing/"),
        ("Agreements & Petitions", "/our-services/agreements-petitions/"),
        ("Other Services", "/our-services/other-services/")
    };
}

<section class="service-detail-hero amalgamation-hero">
    <div class="container site-container">
        <span class="eyebrow">Corporate Restructuring &amp; Strategic Transactions</span>
        <h1>Amalgamation, Merger,<br />De-merger &amp; Takeover</h1>
        <p>Structured support for corporate combinations, acquisitions, de-mergers, takeovers and business restructuring decisions.</p>
    </div>
</section>

<section class="service-detail-section section-space">
    <div class="container site-container">
        <div class="row gy-5">
            <div class="col-lg-8">
                <span class="eyebrow eyebrow-dark">Amalgamation, Merger, De-merger &amp; Takeover</span>
                <h2 class="section-title">Our Services</h2>
                <p class="lead-copy">Corporate restructuring and strategic transactions require careful evaluation of commercial objectives, legal requirements, stakeholder interests and regulatory processes.</p>
                <p>Sonagra &amp; Company helps businesses assess options and implement the right transaction structure.</p>
                <p>Our support combines transaction planning, corporate documentation and regulatory coordination to help promoters, companies and management teams move through complex restructuring matters with clarity.</p>

                <div class="service-detail-points">
                    <h3>Amalgamation, Merger, De-merger &amp; Takeover</h3>
                    <div class="service-detail-list">
                        <article><span>01</span><div><h3>Study of Available Options</h3><p>Study of options available to choose the best mode of acquisition and corporate restructuring.</p></div></article>
                        <article><span>02</span><div><h3>Corporate Strategic Planning and Structuring</h3><p>Corporate strategic planning and structuring aligned with business objectives and transaction needs.</p></div></article>
                        <article><span>03</span><div><h3>Mergers and Demergers</h3><p>Support for merger and demerger matters including transaction planning and process coordination.</p></div></article>
                        <article><span>04</span><div><h3>Acquisitions and Takeovers</h3><p>Assistance in acquisitions and takeovers, including structuring considerations and corporate process support.</p></div></article>
                        <article><span>05</span><div><h3>Reduction / Buy Back of Share Capital</h3><p>Support on reduction and buy-back of share capital, including procedural requirements and documentation.</p></div></article>
                        <article><span>06</span><div><h3>Liquidation and Winding Up of Companies</h3><p>Assistance with liquidation and winding up of companies through applicable compliance and filing stages.</p></div></article>
                        <article><span>07</span><div><h3>Strike Off – Companies and LLPs</h3><p>Strike-off support for companies and LLPs, including documentation and statutory filing requirements.</p></div></article>
                        <article><span>08</span><div><h3>Financial Restructuring</h3><p>Guidance on financial restructuring to align capital and transaction outcomes with business plans.</p></div></article>
                        <article><span>09</span><div><h3>Transaction Accounting Method</h3><p>Determination of transaction accounting method and issues related to the same.</p></div></article>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <aside class="service-detail-sidebar">
                    <h2>Our Services</h2>
                    @foreach (var service in relatedServices)
                    {
                        if (service.Item1 == "Amalgamation, Merger, De-merger & Takeover")
                        {
                            <a class="active" href="@service.Item2">@service.Item1</a>
                        }
                        else
                        {
                            <a href="@service.Item2">@service.Item1 <span>↗</span></a>
                        }
                    }
                </aside>
            </div>
        </div>
    </div>
</section>

<section class="service-detail-cta section-space-sm">
    <div class="container site-container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-8">
                <span class="eyebrow">Restructure with confidence.</span>
                <h2>Plan your next corporate transaction with clarity.</h2>
                <p>Speak with Sonagra &amp; Company for practical support across mergers, de-mergers, acquisitions and restructuring matters.</p>
            </div>
            <div class="col-lg-4 text-lg-end"><a class="btn btn-gold" href="/Home/Contact">Discuss your transaction <span>↗</span></a></div>
        </div>
    </div>
</section>
