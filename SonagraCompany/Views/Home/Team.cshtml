@{
    ViewData["Title"] = "Our Team | Sonagra & Company";
    ViewData["Description"] = "Meet the professionals of Sonagra & Company – Company Secretaries, Chartered Accountants and legal experts supporting corporate governance and compliance.";

    // Photo: put the image in wwwroot/images/team/ and set Photo to its file name.
    var team = new[]
    {
        new TeamMember("CS Jagdish Sonagra", "Practising Company Secretary", "Founder, Sonagra & Company", new[]
        {
            "CS Jagdish Sonagra is a Practising Company Secretary and the Founder of Sonagra & Company, Company Secretaries, based in Morbi, Gujarat, with over 10 years of professional experience in corporate secretarial practice, business structuring and regulatory compliance. A member of the Institute of Company Secretaries of India (ICSI), he advises and assists entrepreneurs, promoters, business owners and corporates across the entire lifecycle of business entities, including selection and formation of appropriate legal structures, incorporation of LLPs and Private Limited Companies, corporate restructuring, statutory compliances and regulatory documentation.",
            "His professional practice encompasses the Companies Act, 2013, Limited Liability Partnership Act, 2008, MCA/ROC compliances, corporate governance, secretarial certifications and business documentation. With substantial exposure to the industrial and business ecosystem, particularly in manufacturing, ceramics, engineering, trading, logistics and export-oriented sectors, he brings practical insight into the legal and regulatory challenges faced by growing businesses. He also advises businesses on import-export registrations, IEC-related matters and various industrial certifications, supporting their regulatory and operational requirements.",
            "Known for his practical, solution-oriented and business-focused approach, Jagdish combines technical knowledge of corporate laws with an understanding of commercial realities, helping promoters and enterprises establish strong legal foundations, maintain regulatory discipline and pursue sustainable business growth."
        }, "jagdish-sonagra.webp"),
        new TeamMember("Mrs. Hiral Jainesh Shah", "Company Secretary", "Senior Professional", new[]
        {
            "Mrs. Hiral Jainesh Shah is a Postgraduate and qualified Company Secretary with extensive experience in the field of corporate secretarial practice and corporate governance. She has been associated with the profession since June 2016.",
            "She completed her academic studies and practical training (articleship) in Mumbai, gaining a strong foundation in corporate laws and secretarial practices.",
            "Her professional experience includes handling corporate secretarial functions, statutory compliances, corporate governance and regulatory matters. She has also served as an Independent Director and has hands-on experience in handling the IPO process of a listed company.",
            "She possesses sound knowledge and practical experience in the legal and regulatory framework governing Private Limited Companies and Limited Liability Partnerships (LLPs), along with expertise in corporate and secretarial compliances.",
            "Currently pursuing her professional career as a Company Secretary, she brings together technical knowledge, practical exposure and a responsible approach to professional assignments.",
            "Known for her amiable personality, courage and considerate nature, she believes in maintaining professional integrity, building meaningful relationships and delivering value through dedicated professional service."
        }, "hiral-jainesh-shah.webp")
    };
}

@functions {
    public record TeamMember(string Name, string Designation, string Qualifications, string[] Bio, string Photo);
}

<section class="service-detail-hero uniform-hero">
    <div class="container site-container">
        <span class="eyebrow">The people behind Sonagra &amp; Company</span>
        <h1>Our Team</h1>
    </div>
</section>

<section class="team-section">
    <div class="container site-container">
        @for (var i = 0; i < team.Length; i++)
        {
            var member = team[i];
            var reverse = i % 2 == 1;
            <article class="team-row @(reverse ? "team-row-reverse" : "")">
                <div class="team-row-text scroll-reveal @(reverse ? "reveal-right" : "reveal-left")">
                    <h2>@member.Name</h2>
                    <p class="team-row-role">@member.Designation &middot; @member.Qualifications</p>
                    @foreach (var paragraph in member.Bio)
                    {
                        <p>@paragraph</p>
                    }
                </div>
                <div class="team-row-photo scroll-reveal @(reverse ? "reveal-left" : "reveal-right")"><img src="~/images/team/@member.Photo" alt="@member.Name" loading="lazy" /></div>
            </article>
        }
    </div>
</section>

<section class="reference-cta section-space-sm">
    <div class="container site-container">
        <div class="reference-cta-inner scroll-reveal reveal-up">
            <div>
                <span class="eyebrow">Corporate expertise. Strategic growth.</span>
                <h2>Speak with our team about your requirement</h2>
            </div>
            <a class="btn btn-gold" href="/Home/Contact">Contact Sonagra &amp; Company <span>↗</span></a>
        </div>
    </div>
</section>
