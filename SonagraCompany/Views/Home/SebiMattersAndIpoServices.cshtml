@{
    ViewData["Title"] = "SEBI Matters and IPO Services | Sonagra & Company";
    ViewData["Description"] = "SEBI and IPO support for listed entities, capital-market transactions, disclosures, certifications and continuing compliance.";

    var relatedServices = new[]
    {
        ("Formation of Business Entities", "/our-services/formation-of-business-entities/"),
        ("Company Law & LLP Compliances", "/our-services/company-law-llp-compliances/"),
        ("SEBI Matters and IPO Services", "/our-services/sebi-matters-and-ipo-services/"),
        ("FEMA Matters", "/our-services/fema-matters/"),
        ("Intellectual Property Rights - Trademark", "/our-services/intellectual-property-rights-trademark-tm/"),
        ("Amalgamation, Merger, De-merger and Takeover", "/our-services/amalgamation-merger-de-merger-takeover/"),
        ("RBI and NBFC Related Compliances", "/our-services/rbi-and-nbfc-related-compliances/"),
        ("Transactional Due Diligence Services", "/our-services/transactional-due-diligence-services/"),
        ("Corporate Governance Services", "/our-services/corporate-governance-services/"),
        ("Corporate Law and Advisory", "/our-services/corporate-law-and-advisory/"),
        ("Liquidation Under Insolvency and Bankruptcy Code 2016", "/our-services/liquidation-under-insolvency-and-bankruptcy-code-2016/"),
        ("NCLT Services", "/our-services/nclt-services/"),
        ("Legal Metrology Act, 2009", "/our-services/legal-metrology-act-2009/"),
        ("XBRL Filing", "/our-services/xbrl-filing/"),
        ("Agreements & Petitions", "/our-services/agreements-petitions/"),
        ("Other Services", "/our-services/other-services/")
    };
}

<section class="service-detail-hero" style="background-image: linear-gradient(90deg, rgba(5, 18, 37, .88), rgba(5, 18, 37, .48)), url('@Url.Content("~/images/SEBI_Matters_and_IPO_Services.png")');">
    <div class="container site-container">
        <span class="eyebrow">Capital Markets &amp; Securities Compliance</span>
        <h1>SEBI Matters and IPO Services</h1>
        <p>Practical support for listed companies, issuers, promoters, investors and regulated intermediaries across SEBI regulations and capital-market transactions.</p>
    </div>
</section>

<section class="service-detail-section section-space">
    <div class="container site-container">
        <div class="row gy-5">
            <div class="col-lg-8">
                <span class="eyebrow eyebrow-dark">SEBI Matters and IPO Services</span>
                <h2 class="section-title">Our Services</h2>
                <p class="lead-copy">Sonagra &amp; Company assists businesses with securities-law compliance, public and private capital raising, listing obligations, issue documentation and continuing regulatory requirements.</p>
                <p>Our work is designed to bring together corporate-law, stock-exchange and SEBI requirements so that every approval, disclosure, certification and post-issue obligation is handled in a timely and well-documented manner.</p>

                <div class="service-detail-points">
                    <h3>SEBI Matters and IPO Services</h3>
                    <div class="service-detail-list sebi-service-detail-list">
                    <article>
                        <h2>1. SEBI LODR Regulations, 2015</h2>
                        <ul class="service-detail-points">
                            <li>Support for corporate-governance requirements applicable to listed entities.</li>
                            <li>Preparation and timely filing of periodic stock-exchange disclosures, financial results, annual reports and shareholding patterns.</li>
                            <li>Advice on board and shareholder meeting procedures and statutory disclosures.</li>
                            <li>Drafting support for board-meeting outcomes, press releases and investor communications.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>2. SEBI ICDR Regulations, 2018</h2>
                        <h3>A. Public Issues (IPO and FPO)</h3>
                        <ul class="service-detail-points">
                            <li>Eligibility assessment and readiness support for listing.</li>
                            <li>PCS certifications for SEBI, stock exchanges and merchant bankers.</li>
                            <li>Certification of compliance with company law and ICDR requirements.</li>
                            <li>Coordination with merchant bankers, registrars, legal advisers and stock exchanges.</li>
                            <li>Guidance on disclosures, lock-in requirements, pricing, issue structure, promoter contribution and general corporate purposes.</li>
                            <li>Drafting of board and shareholder resolutions with post-issue compliance support.</li>
                        </ul>
                        <h3>B. Rights Issues</h3>
                        <ul class="service-detail-points">
                            <li>Advice on issue structure and pricing, in-principle approvals and regulatory coordination.</li>
                            <li>Compliance support for record dates, allotment and dispatch of letters of offer.</li>
                        </ul>
                        <h3>C. Preferential Issues</h3>
                        <ul class="service-detail-points">
                            <li>Board and shareholder resolutions aligned with the Companies Act and ICDR Regulations.</li>
                            <li>Support for pricing formulas, valuation, allotment to promoters or strategic investors, disclosures and lock-in monitoring.</li>
                            <li>Post-allotment filings and stock-exchange disclosures.</li>
                        </ul>
                        <h3>D. Qualified Institutions Placement (QIP)</h3>
                        <ul class="service-detail-points">
                            <li>Advice on eligibility, issue structure, placement documents and offer materials.</li>
                            <li>Verification of minimum allotment and pricing requirements and coordination of disclosures.</li>
                        </ul>
                        <h3>E. Bonus and Sweat Equity Issues</h3>
                        <ul class="service-detail-points">
                            <li>Drafting and review of documentation for bonus shares and sweat equity.</li>
                            <li>Compliance with disclosure and procedural requirements, applicable exemptions and post-issue filings.</li>
                        </ul>
                        <h3>F. Fast Track Issues</h3>
                        <ul class="service-detail-points">
                            <li>Eligibility checks for the fast-track route and support with reduced documentation.</li>
                            <li>Preparation of compliance statements and certification requirements.</li>
                        </ul>
                        <h3>G. Post-Issue Compliance</h3>
                        <ul class="service-detail-points">
                            <li>Post-issue monitoring reports, listing applications and fund-utilisation disclosures.</li>
                            <li>Deviation statements, monitoring-agency certificates, grievance redressal and investor communication support.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>3. SEBI Alternative Investment Funds Regulations, 2012</h2>
                        <ul class="service-detail-points">
                            <li>Registration assistance for Category I, Category II and Category III AIFs.</li>
                            <li>Preparation and submission of applications to SEBI.</li>
                            <li>Drafting and review of private placement memorandums and fund documents.</li>
                            <li>Ongoing compliance relating to investment conditions, reporting and disclosures to SEBI and investors.</li>
                            <li>Advice on changes to sponsors, structure or investment strategy requiring regulatory approval.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>4. SEBI SAST Regulations, 2011</h2>
                        <ul class="service-detail-points">
                            <li>Compliance advice for acquisitions, open offers and takeovers.</li>
                            <li>Preparation of disclosures for acquisitions and changes in shareholding.</li>
                            <li>Assistance to acquirers and target companies in meeting SEBI obligations.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>5. SEBI Prohibition of Insider Trading Regulations, 2015</h2>
                        <ul class="service-detail-points">
                            <li>Drafting and review of codes of conduct for listed entities.</li>
                            <li>Training and awareness programmes for designated persons regarding unpublished price-sensitive information.</li>
                            <li>Trade monitoring, pre-clearance procedures and maintenance of structured digital databases.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>6. SEBI Delisting Regulations, 2021</h2>
                        <ul class="service-detail-points">
                            <li>Advice on voluntary and compulsory delisting processes.</li>
                            <li>Procedural compliance, shareholder approvals and documentation.</li>
                            <li>Liaison support with stock exchanges and merchant bankers.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>7. SEBI Buy-back Regulations, 2018</h2>
                        <ul class="service-detail-points">
                            <li>Advice on buy-back modes such as tender offer and open-market purchase.</li>
                            <li>Drafting support for public announcements and offer documents.</li>
                            <li>Compliance with prescribed timelines, approvals and disclosures.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>8. ESOP and ESPS Schemes</h2>
                        <ul class="service-detail-points">
                            <li>Drafting and vetting of employee stock option and employee stock purchase schemes.</li>
                            <li>Shareholder approvals, implementation and continuing disclosure requirements.</li>
                            <li>Assistance with reporting and documentation for scheme administration.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>9. SEBI RTA Regulations</h2>
                        <ul class="service-detail-points">
                            <li>Liaison with registrars and share-transfer agents.</li>
                            <li>Compliance support for share transfers, record maintenance and investor grievances.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>10. SEBI Debenture Trustees Regulations, 1993</h2>
                        <ul class="service-detail-points">
                            <li>Assistance with appointment and compliance requirements for debenture trustees.</li>
                            <li>Support for creation and review of debenture trust deeds and security documents.</li>
                        </ul>
                    </article>

                    <article>
                        <h2>11. Regulated Market Intermediaries</h2>
                        <p>We support merchant bankers, investment advisers, portfolio managers and research analysts with:</p>
                        <ul class="service-detail-points">
                            <li>Registration and eligibility assessment.</li>
                            <li>Preparation and filing of registration applications.</li>
                            <li>Ongoing compliance, periodic reporting and regulatory documentation.</li>
                        </ul>
                    </article>
                    </div>
                </div>
            </div>

            <aside class="col-lg-4">
                <div class="service-detail-sidebar">
                    <h2>Our Services</h2>
                    @foreach (var service in relatedServices)
                    {
                        if (service.Item1 == "SEBI Matters and IPO Services")
                        {
                            <a class="active" href="@service.Item2">@service.Item1</a>
                        }
                        else
                        {
                            <a href="@service.Item2">@service.Item1 <span>↗</span></a>
                        }
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="service-detail-cta section-space-sm">
    <div class="container site-container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-8">
                <span class="eyebrow">Capital markets. Compliance clarity.</span>
                <h2>Need support with a SEBI or capital-market matter?</h2>
                <p>Speak with Sonagra &amp; Company for structured, practical and compliance-focused assistance.</p>
            </div>
            <div class="col-lg-4 text-lg-end"><a class="btn btn-gold" href="/Home/Contact">Get in touch <span>↗</span></a></div>
        </div>
    </div>
</section>
