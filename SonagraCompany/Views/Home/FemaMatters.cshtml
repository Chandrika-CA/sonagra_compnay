@{
    ViewData["Title"] = "FEMA Matters | Sonagra & Company";
    ViewData["Description"] = "FEMA and FDI support for inbound/outbound investments, reporting, approvals and foreign exchange compliance.";

    var relatedServices = new[]
    {
        ("Formation of Business Entities", "/our-services/formation-of-business-entities/"),
        ("Company Law & LLP Compliances", "/our-services/company-law-llp-compliances/"),
        ("SEBI Matters and IPO Services", "/our-services/sebi-matters-and-ipo-services/"),
        ("FEMA Matters", "/our-services/fema-matters/"),
        ("Intellectual Property Rights - Trademark", "/our-services/intellectual-property-rights-trademark-tm/"),
        ("Amalgamation, Merger, De-merger and Takeover", "/our-services/amalgamation-merger-de-merger-takeover/"),
        ("RBI and NBFC Related Compliances", "/our-services/rbi-and-nbfc-related-compliances/"),
        ("Transactional Due Diligence Services", "/our-services/transactional-due-diligence-services/"),
        ("Corporate Governance Services", "/our-services/corporate-governance-services/"),
        ("Corporate Law and Advisory", "/our-services/corporate-law-and-advisory/"),
        ("Liquidation Under Insolvency and Bankruptcy Code 2016", "/our-services/liquidation-under-insolvency-and-bankruptcy-code-2016/"),
        ("NCLT Services", "/our-services/nclt-services/"),
        ("Legal Metrology Act, 2009", "/our-services/legal-metrology-act-2009/"),
        ("XBRL Filing", "/our-services/xbrl-filing/"),
        ("Agreements & Petitions", "/our-services/agreements-petitions/"),
        ("Other Services", "/our-services/other-services/")
    };
}

<section class="service-detail-hero fema-hero">
    <div class="container site-container">
        <span class="eyebrow">Foreign Exchange &amp; Investment Compliance</span>
        <h1>FEMA Matters</h1>
        <p>Practical support for inbound and outbound investments, FDI, foreign exchange transactions and cross-border business structures.</p>
    </div>
</section>

<section class="service-detail-section section-space">
    <div class="container site-container">
        <div class="row gy-5">
            <div class="col-lg-8">
                <span class="eyebrow eyebrow-dark">FEMA Matters</span>
                <h2 class="section-title">Our Services</h2>
                <p class="lead-copy">Foreign exchange and investment regulations require careful planning, accurate reporting and timely approvals. Sonagra &amp; Company assists businesses, promoters, investors and international groups with FEMA and FDI-related matters across the life cycle of a cross-border transaction.</p>
                <p>Our approach combines practical commercial understanding with structured regulatory support so that foreign investments, overseas arrangements and foreign exchange transactions are properly planned and documented.</p>

                <div class="service-detail-points">
                    <h3>FEMA Matters</h3>
                    <div class="service-detail-list">
                        <article><span>01</span><div><h3>Consultation, Compliance – Inbound and Outbound Investments</h3><p>Consultation, Compliance – Inbound and Outbound Investments.</p></div></article>
                        <article><span>02</span><div><h3>Advice and legal opinions under FEMA</h3><p>Advice and legal opinions under FEMA.</p></div></article>
                        <article><span>03</span><div><h3>Annual and Reporting filings</h3><p>Annual and Reporting filings.</p></div></article>
                        <article><span>04</span><div><h3>Investment strategy for Foreign Companies</h3><p>Investment strategy for Foreign Companies.</p></div></article>
                        <article><span>05</span><div><h3>Approvals, follow up under the FEMA/FDI</h3><p>Approvals, follow up under the FEMA/FDI.</p></div></article>
                        <article><span>06</span><div><h3>Setting up of Overseas Joint Ventures and Wholly Owned Subsidiaries</h3><p>Setting up of Overseas Joint Ventures and Wholly Owned Subsidiaries.</p></div></article>
                        <article><span>07</span><div><h3>External Commercial Borrowings</h3><p>External Commercial Borrowings.</p></div></article>
                        <article><span>08</span><div><h3>Establishment of Branch / Representative Offices for Foreign Business Entities</h3><p>Establishment of Branch / Representative Offices for Foreign Business Entities.</p></div></article>
                        <article><span>09</span><div><h3>Establishment of Joint Ventures, Associate and Wholly Owned Subsidiaries for Foreign Business Entities</h3><p>Establishment of Joint Ventures, Associate and Wholly Owned Subsidiaries for Foreign Business Entities.</p></div></article>
                        <article><span>10</span><div><h3>Liaising with AD Banks for Foreign Exchange Transaction</h3><p>Liaising with AD Banks for Foreign Exchange Transaction.</p></div></article>
                    </div>
                </div>
            </div>

            <aside class="col-lg-4">
                <div class="service-detail-sidebar">
                    <h2>Our Services</h2>
                    @foreach (var service in relatedServices)
                    {
                        if (service.Item1 == "FEMA Matters")
                        {
                            <a class="active" href="@service.Item2">@service.Item1</a>
                        }
                        else
                        {
                            <a href="@service.Item2">@service.Item1 <span>↗</span></a>
                        }
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="reference-cta section-space-sm">
    <div class="container site-container">
        <div class="reference-cta-inner">
            <div>
                <span class="eyebrow">Cross-border business. Clear direction.</span>
                <h2>Plan foreign investment and exchange matters with confidence.</h2>
                <p>Speak with Sonagra &amp; Company for structured FEMA, FDI and foreign exchange compliance assistance.</p>
            </div>
            <a class="btn btn-gold" href="/Home/Contact">Discuss your FEMA matter <span>↗</span></a>
        </div>
    </div>
</section>
