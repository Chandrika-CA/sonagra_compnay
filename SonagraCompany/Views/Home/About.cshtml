@{
    ViewData["Title"] = "About Sonagra & Company";
    ViewData["Description"] = "Learn about Sonagra & Company, a corporate governance, compliance and business advisory firm based in Morbi, Gujarat.";
}

<section class="about-page-hero">
    <div class="container site-container">
        <span class="eyebrow">About Sonagra &amp; Company</span>
        <h1>Corporate Governance &amp;<br />Business Advisory</h1>
        <p>Practical advice. Structured support. Responsible growth.</p>
    </div>
</section>

<section class="section-space about-story-section">
    <div class="container site-container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <div class="about-image-frame">
                    <img src="~/images/sonagra-office-meeting.png" alt="Sonagra and Company professional business meeting" />
                </div>
            </div>
            <div class="col-lg-5 offset-lg-1">
                <span class="eyebrow eyebrow-dark">Who we are</span>
                <h2 class="section-title">A practical partner for important corporate decisions</h2>
                <p class="lead-copy">Sonagra &amp; Company supports businesses, promoters and management teams with dependable corporate and compliance advice.</p>
                <p>Our work is built around a clear understanding of each client’s requirements. We combine structured processes, practical guidance and responsive communication to help organisations manage their corporate responsibilities with confidence.</p>
                <p>From business setup and routine compliance to governance, regulatory matters and strategic advisory, our focus remains on creating clarity and long-term value for every client relationship.</p>
            </div>
        </div>
    </div>
</section>

<section class="about-highlight-section section-space-sm">
    <div class="container site-container">
        <div class="row gy-4">
            <div class="col-lg-4">
                <span class="eyebrow eyebrow-dark">Our approach</span>
                <h2 class="section-title">Professional support with a personal understanding</h2>
            </div>
            <div class="col-lg-7 offset-lg-1">
                <p>We believe corporate advisory should be clear, accessible and connected to the way a business actually operates. Our approach is designed to simplify complex requirements and support informed decisions.</p>
                <p>Confidentiality, integrity and attention to detail are central to the way we work. Every assignment is handled with care, accountability and respect for the trust placed in us.</p>
            </div>
        </div>
    </div>
</section>

<section class="section-space about-capabilities-section">
    <div class="container site-container">
        <div class="text-center about-section-heading">
            <span class="eyebrow eyebrow-dark">What guides us</span>
            <h2 class="section-title">Our values and capabilities</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4"><article class="about-value-card"><span>01</span><h3>Integrity</h3><p>We provide responsible advice with transparency, confidentiality and professional integrity.</p></article></div>
            <div class="col-md-4"><article class="about-value-card"><span>02</span><h3>Clarity</h3><p>We make corporate and regulatory requirements easier to understand and act upon.</p></article></div>
            <div class="col-md-4"><article class="about-value-card"><span>03</span><h3>Commitment</h3><p>We remain responsive and focused on practical outcomes for every client we support.</p></article></div>
        </div>
    </div>
</section>

<section class="about-services-band section-space-sm">
    <div class="container site-container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-8">
                <span class="eyebrow">Corporate expertise. Strategic growth.</span>
                <h2>Supporting businesses with dependable corporate advisory</h2>
                <p>Talk to Sonagra &amp; Company about your corporate requirement, compliance responsibility or business decision.</p>
            </div>
            <div class="col-lg-4 text-lg-end"><a class="btn btn-gold" href="/Home/Contact">Discuss your requirement <span>↗</span></a></div>
        </div>
    </div>
</section>
