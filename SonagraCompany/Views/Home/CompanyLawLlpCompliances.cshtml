@{
    ViewData["Title"] = "Company Law & LLP Compliances | Sonagra & Company";
    ViewData["Description"] = "Company law and LLP compliance support for governance, records, filings, certifications and regulatory representation.";

    var relatedServices = new[]
    {
        ("Formation of Business Entities", "/our-services/formation-of-business-entities/"),
        ("Company Law & LLP Compliances", "/our-services/company-law-llp-compliances/"),
        ("SEBI Matters and IPO Services", "/our-services/sebi-matters-and-ipo-services/"),
        ("FEMA Matters", "/our-services/fema-matters/"),
        ("Intellectual Property Rights - Trademark", "/our-services/intellectual-property-rights-trademark-tm/"),
        ("Amalgamation, Merger, De-merger and Takeover", "/our-services/amalgamation-merger-de-merger-takeover/"),
        ("RBI and NBFC Related Compliances", "/our-services/rbi-and-nbfc-related-compliances/"),
        ("Transactional Due Diligence Services", "/our-services/transactional-due-diligence-services/"),
        ("Corporate Governance Services", "/our-services/corporate-governance-services/"),
        ("NCLT Services", "/our-services/nclt-services/"),
        ("Corporate Law and Advisory", "/our-services/corporate-law-and-advisory/"),
        ("Agreements and Petitions", "/our-services/agreements-petitions/"),
        ("Liquidation under Insolvency and Bankruptcy Code", "/our-services/liquidation-under-insolvency-and-bankruptcy-code-2016/"),
        ("Legal Metrology Act", "/our-services/legal-metrology-act-2009/"),
        ("XBRL Filing", "/our-services/xbrl-filing/"),
        ("Other Services", "/our-services/other-services/")
    };
}

<section class="service-detail-hero company-law-hero">
    <div class="container site-container">
        <span class="eyebrow">Corporate Compliance &amp; Governance</span>
        <h1>Company Law &amp; LLP Compliances</h1>
        <p>Practical and structured support for companies, LLPs, directors, promoters and management teams across statutory and regulatory responsibilities.</p>
    </div>
</section>

<section class="service-detail-section section-space">
    <div class="container site-container">
        <div class="row gy-5 gx-lg-5">
            <div class="col-lg-8">
                <span class="eyebrow eyebrow-dark">Company Law &amp; LLP Compliances</span>
                <h2 class="section-title">Our Services</h2>
                <p class="lead-copy">Company law and LLP compliance is an ongoing responsibility involving directors, shareholders, statutory records, meetings, filings and regulatory reporting.</p>
                <p>Sonagra &amp; Company helps businesses manage these requirements with clear documentation, timely action and practical corporate guidance.</p>
                <p>Our support covers routine compliance as well as structural changes, certifications, audits, regulatory searches and representation before the Registrar of Companies and other authorities.</p>

                <div class="service-detail-points">
                    <h3>Company Law &amp; LLP Compliances</h3>
                    <div class="service-detail-list">
                        <article><span>01</span><div><h3>Company Law and Regulatory Compliances</h3><p>All matters connected with Company Law, Rules and Regulations including Board of Directors compliances, shareholders compliances, charge registration and rectification, search and status reports, and other compliances.</p></div></article>
                        <article><span>02</span><div><h3>Corporatization Advisory</h3><p>Support for corporatization of partnerships and sole proprietary firms.</p></div></article>
                        <article><span>03</span><div><h3>Conversion into LLP</h3><p>Conversion of existing companies, partnerships and sole-proprietary firms into LLPs in a cost and tax-efficient manner, subject to applicable legal requirements.</p></div></article>
                        <article><span>04</span><div><h3>CSR Advisory and Compliance</h3><p>Advisory and compliances pertaining to Corporate Social Responsibility (CSR).</p></div></article>
                        <article><span>05</span><div><h3>Banking and NBFC Compliance Support</h3><p>Setting up, obtaining licenses, renewals and carrying out compliances for Banking Companies and NBFCs, including Asset Finance Companies, Micro Finance Institutions and Core Investment Companies.</p></div></article>
                        <article><span>06</span><div><h3>Policy Drafting</h3><p>Drafting of board policies under the Companies Act, 2013, Listing Regulations, NBFC Regulations and other applicable frameworks.</p></div></article>
                        <article><span>07</span><div><h3>Meeting Documentation</h3><p>Drafting documentation in respect of board and general meetings.</p></div></article>
                        <article><span>08</span><div><h3>Statutory Form Certification</h3><p>Preparation and certification of various statutory forms.</p></div></article>
                        <article><span>09</span><div><h3>Annual Return Certificate (MGT-8)</h3><p>Issuance support for Annual Return Certificate (MGT-8).</p></div></article>
                        <article><span>10</span><div><h3>Directors’ Report Preparation</h3><p>Preparation of Directors’ Report.</p></div></article>
                        <article><span>11</span><div><h3>Statutory Registers and Records</h3><p>Updating statutory records and registers.</p></div></article>
                        <article><span>12</span><div><h3>Meeting Attendance Support</h3><p>Attending board and general meetings as required.</p></div></article>
                        <article><span>13</span><div><h3>Secretarial Audit Report</h3><p>Issuance of Secretarial Audit Report.</p></div></article>
                        <article><span>14</span><div><h3>Internal Audit</h3><p>Internal audit support for governance and compliance review.</p></div></article>
                        <article><span>15</span><div><h3>Listing and Capital Market Certifications</h3><p>Audit and certifications under Listing Regulations and other capital market regulations.</p></div></article>
                        <article><span>16</span><div><h3>Corporate Changes</h3><p>Name change, object change and shifting of registered office.</p></div></article>
                        <article><span>17</span><div><h3>Bank Due Diligence Certificate</h3><p>Providing bank due diligence certificate support.</p></div></article>
                        <article><span>18</span><div><h3>ROC Search and Document Retrieval</h3><p>Physical search from ROCs and document obtention support.</p></div></article>
                        <article><span>19</span><div><h3>Regulatory Representation</h3><p>Appearing before the Regional Director and Registrar of Companies.</p></div></article>
                    </div>
                </div>
            </div>

            <aside class="col-lg-4">
                <div class="service-detail-sidebar company-law-reference-sidebar">
                    <h2>Our Services</h2>
                    @foreach (var service in relatedServices)
                    {
                        if (service.Item1 == "Company Law & LLP Compliances")
                        {
                            <a class="active" href="@service.Item2">@service.Item1</a>
                        }
                        else
                        {
                            <a href="@service.Item2">@service.Item1 <span>↗</span></a>
                        }
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="reference-cta section-space-sm">
    <div class="container site-container">
        <div class="reference-cta-inner">
            <div>
                <span class="eyebrow">Corporate compliance. Clear direction.</span>
                <h2>Need help with company law or LLP compliance?</h2>
                <p>Speak with Sonagra &amp; Company for practical and structured support.</p>
            </div>
            <a class="btn btn-gold" href="/Home/Contact">Get in touch <span>↗</span></a>
        </div>
    </div>
</section>
