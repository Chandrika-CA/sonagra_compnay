                                        <a role="menuitem" href="/our-services/nclt-services" target="_blank" rel="noopener noreferrer">NCLT Services</a>
                                        <a role="menuitem" href="/our-services/legal-metrology-act-2009" target="_blank" rel="noopener noreferrer">Legal Metrology Act, 2009</a>
                                        <a role="menuitem" href="/our-services/xbrl-filing" target="_blank" rel="noopener noreferrer">XBRL Filing</a>
                                        <a role="menuitem" href="/our-services/agreements-petitions" target="_blank" rel="noopener noreferrer">Agreements &amp; Petitions</a>
                                        <a role="menuitem" href="/our-services/other-services" target="_blank" rel="noopener noreferrer">Other Services</a>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Sectors">Sectors</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Team">Our Team</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Careers">Careers</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Home/Blogs">Blogs</a></li>
                        <li class="nav-item nav-contact-item"><a class="nav-link nav-contact-link" href="/Home/Contact">Contact Us <span aria-hidden="true">↗</span></a></li>
                    </ul>
                </div>
            </div>
