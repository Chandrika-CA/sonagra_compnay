    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sonagra &amp; Company</title>
    <meta name="description" content="@(ViewData["Description"] ?? "Sonagra & Company provides company law compliance, ROC filing, corporate governance and advisory services in Morbi, Gujarat.")" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SonagraCompany.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="topbar">
            <div class="container site-container topbar-inner">
                <span>Strategic advice for responsible growth</span>
                <div class="topbar-contact">
                    <a href="mailto:cs@sonagra.com">cs@sonagra.com</a>
                    <span class="topbar-divider"></span>
                    <a href="tel:+917567096966">Mobile: +91 75670 96966</a>
                    <a href="tel:+917567096967">Office: +91 75670 96967</a>
                </div>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg main-nav" aria-label="Main navigation">
            <div class="container site-container">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Sonagra and Company home">
                    <img class="brand-logo" src="~/images/sonagra-logo.png" alt="Sonagra &amp; Company" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
